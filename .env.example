# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (proyecto: smv-brain) ---
# Opcional. Si faltan, el audit trail de analysisRuns queda deshabilitado
# sin romper la aplicación. Estas claves son las de la Web App de Firebase
# y NO son secretas (viajan al cliente), pero se cargan por entorno para
# separar dev / staging / prod.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# --- App Check (opcional pero recomendado en prod) ---
# Site key de reCAPTCHA v3. Registra el dominio en
# https://www.google.com/recaptcha/admin y pega el site key aqui.
# Con enforcement de App Check en Auth, esta clave es necesaria para iniciar sesión.
# En dev suele usarse debug: copia el token de consola o usa UUID fijo:
VITE_RECAPTCHA_SITE_KEY=""
VITE_APPCHECK_DEBUG=""
# Opcional: UUID de debug registrado en Firebase Console → App Check (sin depender del token impreso).
VITE_APPCHECK_DEBUG_TOKEN=""
# Legado; ya no hace falta para "habilitar" localhost si hay site key + debug.
VITE_APPCHECK_ALLOW_LOCALHOST=""
