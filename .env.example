# Gemini API key — NO vive aquí. Las llamadas a Gemini pasan por la Cloud
# Function callable `analyzeGemini` (functions/src/gemini.ts): el navegador
# nunca ve la key. Se configura como secreto de Secret Manager, igual que
# ODOO_API_KEY:
#   firebase functions:secrets:set GEMINI_API_KEY
# (Antes de esto, VITE_GEMINI_API_KEY vivía aquí y Vite la insertaba como
# texto plano en el bundle del navegador — cualquiera que abriera el sitio
# podía leerla. Requiere Firebase (Functions + Auth) configurado; no hay
# fallback "solo Gemini sin Firebase".)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (proyecto: smv-brain) ---
# Opcional. Si faltan, el audit trail de analysisRuns queda deshabilitado
# sin romper la aplicación. Estas claves son las de la Web App de Firebase
# y NO son secretas (viajan al cliente), pero se cargan por entorno para
# separar dev / staging / prod.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# --- App Check (opcional pero recomendado en prod) ---
# src/lib/firebase/client.ts inicializa App Check automáticamente si
# VITE_RECAPTCHA_SITE_KEY está presente (antes de la primera llamada a
# Firestore/Storage/Functions). Sin esta variable, App Check simplemente
# no se activa — no rompe nada.
#
# Site key de reCAPTCHA v3. Registra el dominio en
# https://www.google.com/recaptcha/admin y pega el site key aqui.
# PASO MANUAL APARTE (Firebase Console → App Check): registrar la app con
# este site key y decidir si activas "Enforce" en Firestore/Storage/Functions.
# El código funciona en modo "monitor" (no enforced) aunque no lo actives ahí.
VITE_RECAPTCHA_SITE_KEY=""
# En dev suele usarse debug: copia el token de consola o usa UUID fijo:
VITE_APPCHECK_DEBUG=""
# Opcional: UUID de debug registrado en Firebase Console → App Check (sin depender del token impreso).
VITE_APPCHECK_DEBUG_TOKEN=""

# --- Tool Crib debug ---
# Solo para desarrollo local: permite consultar biblioteca Tool Crib sin sesión.
# NO afecta producción (el bypass solo se habilita si import.meta.env.DEV).
VITE_TOOLCRIB_DEBUG_ALLOW_UNAUTH=""

# --- Odoo 15 Sync (solo backend/scripts — nunca exponer en el cliente) ---
# URL base de la instancia Odoo (sin barra final). Ej: https://empresa.odoo.com
ODOO_URL=""
# Nombre de la base de datos Odoo.
ODOO_DB=""
# Email o username de la cuenta Odoo con acceso a sale.order.
ODOO_USER=""
# API Key de Odoo: Configuración → Técnico → API Keys → Nueva Clave.
ODOO_API_KEY=""

