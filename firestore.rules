rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SMV-VISION → Firestore database "(default)" en proyecto smv-brain.
    // SMV-Hub usa la DB nombrada "compras-americanas" (reglas aparte).
    // NUNCA desplegar las reglas del Hub sobre (default): dejan sin acceso
    // a odooSaleOrders / toolcrib* / purchases (deny por catch-all).
    //
    // App privada — solo usuarios autenticados (cuentas creadas a mano en
    // Firebase Console → Authentication). No hay registro público.
    //
    // Principio: mínimo privilegio por colección. Las colecciones que solo
    // escribe el backend (Cloud Function) usan el Admin SDK, que IGNORA
    // estas reglas — por eso aquí quedan como solo lectura.
    // La validación de forma vive en validators TS; las reglas garantizan
    // identidad y superficie de escritura.

    // La base (default) de smv-brain la comparte el Dashboard, que exige la autenticación
    // ANÓNIMA habilitada (TV pública). Un anónimo no es usuario de Vision: sin esto podía leer
    // OTs y planos y crear/editar/borrar compras (probado en tests/firestore-rules.emulator.test.ts).
    function isSignedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── Escritas solo por Admin SDK (sync Odoo / Cloud Function) ──────────
    match /odooSaleOrders/{orderId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /syncMeta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /workOrders/{otId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Catálogo Tool Crib (lectura + altas/ediciones desde la app) ───────
    match /toolcribParts/{partId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false; // el dedupe borra vía Admin SDK
    }

    match /toolcribDrawings/{drawingId} {
      allow read: if isSignedIn();
      // El uploader firma el documento con su propio uid.
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid;
      // Un update nunca puede tocar la firma de procedencia (los planos
      // antiguos del bootstrap no traen el campo — diff() los tolera).
      allow update: if isSignedIn()
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['createdByUid']);
      allow delete: if false; // el dedupe borra vía Admin SDK
    }

    // ── Logs de auditoría: solo altas, inmutables, uid no falsificable ────
    match /toolcribPrintLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.printedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /analysisRuns/{runId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Catálogo de compras (CRUD completo desde ComprasPanel) ────────────
    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ── Bóveda de herramental (CRUD desde Herramental → Mi Bóveda) ─────
    match /toolingPurchases/{itemId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ── Memoria de alias de piezas (puente orden-plano) ───────────────────
    match /partAliases/{aliasId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ── Juegos (pares/hojas/complementos) y notas permanentes por pieza ───
    match /toolcribSets/{setId} {
      allow read, create, update, delete: if isSignedIn();
    }
    match /toolcribPartNotes/{noteId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ── Dashboard (Visual Factory TV) — misma base (default) ──────────────
    // Copia FIEL de visual-factory-tv-dashboard/firestore.rules: las dos apps despliegan reglas
    // a esta base y la última gana. Si cambias algo aquí, cámbialo también allá.
    function dashIsVerifiedAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.token.email_verified == true
          && request.auth.token.admin == true;
    }
    function dashIsValidCompanyConfig() {
      let allowedFields = ['company_name', 'delivery_schedule', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowedFields)
          && request.resource.data.keys().hasAll(allowedFields)
          && request.resource.data.company_name is string
          && request.resource.data.company_name.size() >= 1
          && request.resource.data.company_name.size() <= 100
          && request.resource.data.delivery_schedule is string
          && request.resource.data.delivery_schedule.size() >= 1
          && request.resource.data.delivery_schedule.size() <= 500
          && request.resource.data.updatedAt is timestamp;
    }
    match /company_configs/{configId} {
      allow read: if request.auth != null; // la TV anónima la lee
      allow create, update: if dashIsVerifiedAdmin() && dashIsValidCompanyConfig();
      allow delete: if dashIsVerifiedAdmin();
    }
    match /work_orders/{orderId} {
      allow read, write: if false;
    }
    match /work_orders_history/{historyId} {
      allow read, write: if false;
    }

    // ── Todo lo demás: denegado ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
