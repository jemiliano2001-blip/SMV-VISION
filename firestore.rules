rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Uso personal — un solo usuario autenticado.
    // La validación de datos vive en el código TypeScript, no aquí.
    // Si en el futuro se comparte la app, agregar reglas por colección.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
