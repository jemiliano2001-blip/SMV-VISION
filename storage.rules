rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Ruta real usada por el pipeline activo (toolcribEdrawingsIso.ts,
    // toolcribUploadStls.ts, toolcribUploadPdfs.ts): `tool-crib/{customer}/{filename}`.
    // Antes esta regla protegía `toolcrib/drawings/{partId}/**`, que ningún
    // script escribe — todo el catálogo dependía únicamente del download token
    // de la URL (que ignora estas reglas) para funcionar.
    match /tool-crib/{customer}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024 // 25MB máximo (cubre STL + PDF)
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('model/stl')
                       || request.resource.contentType.matches('application/sla')
                       || request.resource.contentType.matches('image/jpeg'));
    }
    // Ruta legado de scripts/toolcribBootstrap.ts: `toolcrib/{partId}/{revision}.pdf`.
    // Se conserva por compatibilidad con planos ya subidos por esa vía.
    match /toolcrib/{partId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024 // 10MB máximo
                   && request.resource.contentType.matches('application/pdf');
    }
    match /{allPaths=**} {
      allow read, write: if false; // Por defecto denegar todo lo demás
    }
  }
}
